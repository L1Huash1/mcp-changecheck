{
  "tools": [
    {
      "name": "search_notes",
      "description": "Search local notes by query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {"type": "string"},
          "limit": {"type": "integer"}
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "annotations": {"readOnlyHint": true, "openWorldHint": false}
    },
    {
      "name": "archive_note",
      "description": "Archive a note after confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {"note_id": {"type": "string"}},
        "required": ["note_id"]
      }
    }
  ]
}
